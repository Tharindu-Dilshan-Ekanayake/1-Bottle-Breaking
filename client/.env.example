# Optional. Copy to `.env` (or `.env.local`) to override.

# The game slug from the Boxity developer dashboard. Defaults to 1-bottle-breaking
# (src/bloxity/identity.js); the deploy workflow passes it too.
# VITE_GAME_SLUG=1-bottle-breaking

# The hosting id on Boxity Legion. Set it (the deploy workflow does) and the game
# connects through Boxity's matchmaker (Legion.SDK.net.resolveEndpoint). Never point
# anything at <id>.host.bloxity.io.
# VITE_LEGION_GAME_ID=

# `vite dev` talks to a local Boxity stack by default (localhost:4000 API, :3000 portal).
# Develop against production Boxity (real logins) instead:
# BLOXITY_DEV_ENV=prod

# No Boxity URLs here, ever: the platform tells the page which environment it runs in
# (window.BLOXITY_ENV / Legion.SDK.environment(), see src/bloxity/env.js). In `vite dev`
# a local Boxity stack is assumed unless BLOXITY_DEV_ENV=prod (above).
