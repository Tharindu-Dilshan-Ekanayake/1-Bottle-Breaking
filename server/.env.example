# Copy to .env (git-ignored). On Bloxity Legion none of this is needed: it injects
# PORT, CLIENT_ORIGIN, MONGODB_URI, BLOXITY_GAME_ID, POD_NAME and the BLOXITY_* URLs.
PORT=2567
# Extra allowed browser origins, comma-separated.
CLIENT_ORIGINS=
# Leave unset locally to save to data/bottle.db (SQLite); set to use MongoDB instead.
# MONGODB_URI=mongodb://localhost:27017/bottle

# Setting BLOXITY_ENV (or NODE_ENV=production) makes the server strict about identity:
# players without a verified Boxity token are always guests.
# BLOXITY_ENV=local
# BLOXITY_API_URL=http://localhost:4000
# BLOXITY_GAME_ID=1-bottle-breaking
# BLOXITY_GAME_SLUG=1-bottle-breaking

# Boxity platform features (Boxity hosting injects these; without them they're off):
# BLOXITY_REPORT_TOKEN=       leaderboard reports and the Open Rooms reporter
# MATCHMAKER_REPORT_URL=      where the Open Rooms reporter posts this pod's rooms
# LEGION_WEBHOOK_SECRET=      must match the Gems webhook's x-legion-webhook-secret
