{
  "name": "server",
  "version": "1.0.0",
  "description": "Authoritative game server for Bottle Tumble: Colyseus rooms, persistence and Bloxity auth.",
  "main": "src/server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@colyseus/core": "0.18.22",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "cors": "2.8.6",
    "express": "5.2.1",
    "mongodb": "7.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
